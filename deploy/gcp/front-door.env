# This project's values for deploy/gcp/front-door.sh. No secrets here, so the file is committed.
# Moving to another GCP project: copy front-door.env.example, edit it, run the script with the new file.
PROJECT=se-project-49281
REGION=africa-south1
SERVICE=water-works-os
BILLING_ACCOUNT=01B233-16D37B-41FAFF
BUDGET_USD=25
BUDGET_CURRENCY=USD
ALERT_EMAIL=matthewkoeberg13@gmail.com
IAP_USERS=matthewkoeberg13@gmail.com,matthew@novatekllc.co.za
# Claude through the first-party API, its key in Secret Manager, until Vertex grants this project Claude quota;
# then LLM_PROVIDER=vertex and redeploy.
LLM_PROVIDER=anthropic
ANTHROPIC_SECRET=anthropic-api-key
# From Model Garden (2026-11-07): Claude Opus 5.5 is served from the global endpoint only, none in Africa.
VERTEX_REGION=global
LLM_MODEL=claude-opus-5-5
SERVICE_ACCOUNT_NAME=wateros-run
# This project has no organisation, so IAP needs a custom OAuth client: the path to its JSON, outside the repo (see the example).
IAP_OAUTH_CLIENT_FILE=
