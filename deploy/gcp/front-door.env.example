# Parameters for deploy/gcp/front-door.sh. Copy to front-door.env and edit. No secrets belong here.
# Today's values (project se-project-49281) are in the comments.

PROJECT=my-project-id               # se-project-49281
REGION=africa-south1                # africa-south1: Cloud Run and IAP region
SERVICE=water-works-os              # water-works-os
BILLING_ACCOUNT=XXXXXX-XXXXXX-XXXXXX  # 01B233-16D37B-41FAFF
BUDGET_USD=25                       # 25: alerts at 50%, 90% and 100% of this, in BUDGET_CURRENCY
BUDGET_CURRENCY=USD                 # USD: must be the billing account's currency (a South African company account may be ZAR); empty uses the account's own
ALERT_EMAIL=you@example.com         # matthewkoeberg13@gmail.com: uptime alerts go here
IAP_USERS=a@example.com,b@example.com  # matthewkoeberg13@gmail.com,matthew@novatekllc.co.za: comma-separated; also become WWOS_OPERATORS (each =*)

# How the app reaches Claude: anthropic (the first-party API; the key goes to Secret Manager from $ANTHROPIC_API_KEY
# in your shell, never from a file) or vertex (Vertex AI as the service account, no key).
LLM_PROVIDER=anthropic              # anthropic, until Vertex grants se-project-49281 Claude quota
ANTHROPIC_SECRET=anthropic-api-key  # anthropic-api-key: the Secret Manager secret that holds the key (anthropic only)

# Claude's model, and the Vertex AI region (used when LLM_PROVIDER=vertex). Confirmed in Model Garden on 2026-11-07:
# Claude Opus 5.5 is served from the global endpoint only, none in Africa.
VERTEX_REGION=global                # global
LLM_MODEL=claude-opus-5-5           # claude-opus-5-5

SERVICE_ACCOUNT_NAME=wateros-run    # wateros-run (optional; this is the default)

# For a project with no organisation (se-project-49281 has none), or with IAP_USERS outside it: IAP then needs a custom OAuth client.
# The absolute path, with forward slashes, to the client JSON downloaded from the Console. Keep the file outside
# the repo: it holds the client secret. docs/CLOUD-RUN.md, "IAP sign-in without an organisation", has the steps.
IAP_OAUTH_CLIENT_FILE=              # e.g. C:/Users/you/secrets/wateros-iap-client.json
